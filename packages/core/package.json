{
  "name": "@forma/core",
  "version": "0.1.0",
  "description": "Forma geometry core: document model, evaluator (Manifold), module SDK, exporters",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./modules": "./src/modules/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.json --emitDeclarationOnly false --outDir dist",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "manifold-3d": "^3.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
